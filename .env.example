# Supabase project URL and publishable (anon) key.
# Both are exposed to the browser, so they must not contain secret values.
# Copy this file to .env.local and fill in the values from your Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Development seeding and RLS checks only --------------------------------
# Used by scripts/seed-dev.mjs (npm run seed:dev) and scripts/verify-rls.mjs
# (npm run verify:rls). Run the seed first; the RLS suite signs in as the
# seeded accounts.
# Server-side only. Never prefix these with NEXT_PUBLIC_ and never commit real
# values: the service role key bypasses Row Level Security entirely.

# Defaults to NEXT_PUBLIC_SUPABASE_URL. Set it to http://127.0.0.1:54321 to
# seed a local stack while NEXT_PUBLIC_SUPABASE_URL points elsewhere.
SUPABASE_URL=

# From `supabase status` locally, or the development project's API settings.
SUPABASE_SERVICE_ROLE_KEY=

# Password given to the demo owner/manager/baker accounts.
SEED_DEV_PASSWORD=

# Email domain for the demo accounts. Defaults to demo.cakeflow.test.
SEED_DEV_EMAIL_DOMAIN=

# Required to write to anything other than localhost. Guards against pointing
# these scripts at a real project by accident.
SEED_ALLOW_REMOTE=false

# Only needed if NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY points somewhere other
# than the database being verified. verify-rls.mjs signs in with this key.
SUPABASE_PUBLISHABLE_KEY=
